# Composer
/vendor/

# Fichiers générés
schemaspy.last.json
/tmp/schemaspy_*.properties
*.log

# Environnement
# (les outils embarqués tools/ ne sont jamais versionnés)

# JDBC drivers (si copiés depuis la racine)
/jdbc/*.jar

# JAR SchemaSpy (téléchargé via schemaspy.download_url dans config.json)
/jar/*.jar

# Rapports générés par SchemaSpy / sorties de test
/report/*
/test_output/

# Fichier de log (écrasé à chaque exécution, cf. Logger)
/logs/*

# IDE
.vscode/
.idea/
.claude/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Tests - artefacts générés (le code des tests reste versionné)
/tests/coverage/
/tests/coverage.txt
/tests/coverage.xml
/tests/.phpunit.result.cache
/coverage/
/tools/*
/jdbc/old/

# Fichier markdown
AGENTS.md
!/jar/readme.md
!/jdbc/readme.md
!/logs/readme.md
!/report/readme.md
!/tools/readme.md
