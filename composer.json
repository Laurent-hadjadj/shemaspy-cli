{
    "name": "mamoulinette/schemaspy-cli",
    "description": "SchemaSpy CLI - Générateur de documentation de bases de données",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Laurent HADJADJ",
            "email": "laurent_h@me.com"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "phpunit/php-code-coverage": "^9.2",
        "symfony/var-dumper": "^5.4"
    },
    "autoload": {
        "psr-4": {
            "SchemaSpyCli\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SchemaSpyCli\\Tests\\": "tests/"
        }
    },
    "bin": ["bin/schemaspy"],
    "scripts": {
        "post-install-cmd": [
            "chmod +x bin/schemaspy"
        ],
        "test": [
            "vendor/bin/phpunit -c tests/phpunit.xml"
        ],
        "test-coverage": [
            "vendor/bin/phpunit -c tests/phpunit.xml --coverage-html coverage/"
        ]
    }
}
